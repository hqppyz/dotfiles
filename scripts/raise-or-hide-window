#!/usr/bin/env bash

source require-x11

set -u

ACTION=
WORKSPACE=
STATE_FILE="/tmp/minimized-stack-$USER"

raise_fallback() {
    if [[ -n $WORKSPACE ]]; then
        raise-hidden-window --workspace "$@"
    else
        raise-hidden-window "$@"
    fi
}

current_workspace() {
    local ws

    ws=$(xprop -root _NET_CURRENT_DESKTOP 2>/dev/null |
        awk -F' = ' '/_NET_CURRENT_DESKTOP/ {print $2; exit}')

    [[ $ws =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$ws"
}

window_workspace() {
    local id=$1 ws

    ws=$(xprop -id "$id" _NET_WM_DESKTOP 2>/dev/null |
        awk -F' = ' '/_NET_WM_DESKTOP/ {print $2; exit}')

    [[ $ws =~ ^[0-9]+$ || $ws =~ ^0x[0-9a-fA-F]+$ ]] || return 1
    printf '%s\n' "$ws"
}

window_exists() {
    local id=$1 ws

    xprop -id "$id" WM_CLASS >/dev/null 2>&1 || return 1

    [[ -z $WORKSPACE ]] && return 0

    ws=$(window_workspace "$id") || return 1
    [[ $ws == "$WORKSPACE" ]]
}

window_hidden() {
    xprop -id "$1" _NET_WM_STATE 2>/dev/null | grep -q '_NET_WM_STATE_HIDDEN'
}

window_label() {
    local id=$1 label

    label=$(xprop -id "$id" WM_CLASS 2>/dev/null |
        sed -n 's/^WM_CLASS(STRING) = //p')
    [[ -n $label ]] && { printf '%s\n' "$label"; return; }

    label=$(xprop -id "$id" _NET_WM_NAME 2>/dev/null |
        sed -n 's/^_NET_WM_NAME(UTF8_STRING) = //p')
    [[ -n $label ]] && { printf '%s\n' "$label"; return; }

    label=$(xprop -id "$id" WM_NAME 2>/dev/null |
        sed -n 's/^WM_NAME(STRING) = //p')
    [[ -n $label ]] && { printf '%s\n' "$label"; return; }

    printf '<unknown>\n'
}

raise_from_stack() {
    local id
    local -a ids

    touch "$STATE_FILE"
    mapfile -t ids < "$STATE_FILE"

    for (( i=${#ids[@]}-1; i>=0; i-- )); do
        id=${ids[i]}

        window_exists "$id" || continue
        window_hidden "$id" || continue

        wmctrl -i -R "$id" >/dev/null 2>&1 || continue

        for (( j=0; j<i; j++ )); do
            printf '%s\n' "${ids[j]}"
        done > "$STATE_FILE"

        return 0
    done

    : > "$STATE_FILE"
    return 1
}

hide_active() {
    local id

    id=$(xdotool getactivewindow 2>/dev/null) || exit 1
    [[ -n $id ]] || exit 1

    id=$(printf '0x%x\n' "$id")

    # Register into stack
    touch "$STATE_FILE"
    if [[ -s $STATE_FILE ]] && tail -n 1 "$STATE_FILE" 2>/dev/null | grep -qxF "$id"; then
        return
    fi
    printf '%s\n' "$id" >> "$STATE_FILE"

    # Hide
    wmctrl -i -r "$id" -b add,hidden >/dev/null 2>&1
}

list_stack() {
    local id status label
    local -a ids

    touch "$STATE_FILE"
    mapfile -t ids < "$STATE_FILE"

    if (( ${#ids[@]} == 0 )); then
        echo "[stack empty]"
    else
        for (( i=${#ids[@]}-1; i>=0; i-- )); do
            id=${ids[i]}

            if ! window_exists "$id"; then
                status="dead"
            elif window_hidden "$id"; then
                status="ok"
            else
                status="visible"
            fi

            label=$(window_label "$id")
            printf '%s | %s | %s\n' "$id" "$status" "$label"
        done
    fi

    echo "--- fallback ---"
    raise_fallback --list 2>/dev/null
}

while (( $# )); do
    case "$1" in
        --workspace)
            WORKSPACE=$(current_workspace) || {
                echo "ERROR: Could not retrieve current workspace." >&2
                exit 1
            }
            STATE_FILE="${STATE_FILE}-ws-${WORKSPACE}"
            ;;
        --hide|--raise|--list)
            [[ -z $ACTION ]] || {
                echo 'ERROR: Cannot execute more than one action.' >&2
                exit 1
            }
            ACTION=$1
            ;;
        *)
            printf 'Usage: %s [--workspace] --hide | --raise | --list\n' "$0" >&2
            exit 1
            ;;
    esac
    shift
done

case "$ACTION" in
    --hide)
        hide_active
        ;;
    --raise)
        raise_from_stack || raise_fallback
        ;;
    --list)
        list_stack
        ;;
    *)
        if [[ -z $ACTION ]]; then
            echo "ERROR: Missing action." >&2
        else
            echo "ERROR: Unknown action '$ACTION'." >&2
        fi
        exit 1
        ;;
esac

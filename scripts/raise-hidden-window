#!/usr/bin/env bash

source require-x11

LIST_MODE=
WORKSPACE=

current_workspace() {
    local ws

    ws=$(xprop -root _NET_CURRENT_DESKTOP 2>/dev/null |
        awk -F' = ' '/_NET_CURRENT_DESKTOP/ {print $2; exit}')

    [[ $ws =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$ws"
}

window_workspace() {
    local id=$1 ws

    ws=$(xprop -id "$id" _NET_WM_DESKTOP 2>/dev/null |
        awk -F' = ' '/_NET_WM_DESKTOP/ {print $2; exit}')

    [[ $ws =~ ^[0-9]+$ || $ws =~ ^0x[0-9a-fA-F]+$ ]] || return 1
    printf '%s\n' "$ws"
}

window_time() {
    local id=$1 t ref

    t=$(xprop -id "$id" _NET_WM_USER_TIME 2>/dev/null |
        awk -F' = ' '/_NET_WM_USER_TIME/ {print $2}')
    if [[ $t =~ ^[0-9]+$ ]]; then
        printf '%s|window\n' "$t"
        return
    fi

    ref=$(xprop -id "$id" _NET_WM_USER_TIME_WINDOW 2>/dev/null |
        awk -F'# ' '/_NET_WM_USER_TIME_WINDOW/ {print $2}')
    if [[ $ref =~ ^0x[0-9a-fA-F]+$ ]]; then
        t=$(xprop -id "$ref" _NET_WM_USER_TIME 2>/dev/null |
            awk -F' = ' '/_NET_WM_USER_TIME/ {print $2}')
        if [[ $t =~ ^[0-9]+$ ]]; then
            printf '%s|time-window\n' "$t"
            return
        fi
    fi

    printf '0|none\n'
}

window_label() {
    local id=$1 label

    label=$(xprop -id "$id" WM_CLASS 2>/dev/null |
        sed -n 's/^WM_CLASS(STRING) = //p')
    [[ -n $label ]] && { printf '%s\n' "$label"; return; }

    label=$(xprop -id "$id" _NET_WM_NAME 2>/dev/null |
        sed -n 's/^_NET_WM_NAME(UTF8_STRING) = //p')
    [[ -n $label ]] && { printf '%s\n' "$label"; return; }

    label=$(xprop -id "$id" WM_NAME 2>/dev/null |
        sed -n 's/^WM_NAME(STRING) = //p')
    [[ -n $label ]] && { printf '%s\n' "$label"; return; }

    printf '<unknown>\n'
}

while (( $# )); do
    case "$1" in
        --workspace)
            WORKSPACE=$(current_workspace) || {
                echo "ERROR: Could not retrieve current workspace." >&2
                exit 1
            }
            ;;
        --list)
            LIST_MODE=1
            ;;
        *)
            printf 'Usage: %s [--workspace] [--list]\n' "$0" >&2
            exit 1
            ;;
    esac
    shift
done

best_id=
best_time=-1
fallback_id=

while read -r id; do
    state=$(xprop -id "$id" _NET_WM_STATE 2>/dev/null) || continue
    [[ $state == *"_NET_WM_STATE_HIDDEN"* ]] || continue
    [[ -z $WORKSPACE || $(window_workspace "$id") == "$WORKSPACE" ]] || continue
    [[ -z $fallback_id ]] && fallback_id=$id

    IFS='|' read -r t source < <(window_time "$id")

    if [[ -n "$LIST_MODE" ]]; then
        label=$(window_label "$id")
        printf '%s | %s | %s | %s\n' "$id" "$t" "$source" "$label"
    fi

    if (( t > best_time )); then
        best_time=$t
        best_id=$id
    fi
done < <(
    xprop -root _NET_CLIENT_LIST_STACKING 2>/dev/null |
    sed 's/^.*# //' |
    tr ',' '\n' |
    tr -d ' '
)

if [[ -z "$LIST_MODE" ]]; then
    wmctrl -i -R "${best_id:-$fallback_id}" 2>/dev/null
fi

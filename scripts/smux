#!/usr/bin/env bash
# Create or attach to a tmux named session
# Usage: smux            (list alive sessions)
#        smux <session> [<command> [<args>...]]
# Dependencies: tmux

source require-colors

if [ $# -lt 1 ]; then
    tmux list-sessions -F '#{session_name}' 2>/dev/null \
        || printf "${C_YELLOW}No tmux sessions${C_RESET}\n" >&2
    exit 0
fi

SESSION="$1"
shift

exec tmux new-session -A -s "$SESSION" "$@"
